<?xml version="1.0" encoding="utf-8"?>
<!--
  Aturan extraction untuk Android 12+ (API 31+).
  Memisahkan rule untuk:
    - cloud-backup: backup ke Google Drive (off-device)
    - device-transfer: transfer langsung antar device (D2D)

  Mengizinkan database SQLite, foto struk, folder Backups manual,
  dan shared preferences untuk keduanya, agar saat user beli HP baru
  atau reinstall, data akan otomatis pulih.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="kaze_garage.db" />
        <include domain="database" path="kaze_garage.db-journal" />
        <include domain="database" path="kaze_garage.db-shm" />
        <include domain="database" path="kaze_garage.db-wal" />
        <include domain="file" path="receipts/" />
        <include domain="external" path="Backups/" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="kaze_garage.db" />
        <include domain="database" path="kaze_garage.db-journal" />
        <include domain="database" path="kaze_garage.db-shm" />
        <include domain="database" path="kaze_garage.db-wal" />
        <include domain="file" path="receipts/" />
        <include domain="external" path="Backups/" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>